# =============================================================================
# puzi_project — Git upload safety rules
# Purpose: exclude credentials, copyrighted scores, generated artifacts,
#          local tools, caches, and IDE/ZCode local state.
# =============================================================================

# ---------------------------------------------------------------------------
# Local tools / downloaded third-party binaries
# ---------------------------------------------------------------------------
.tools/
*.zip
*.exe
*.tar.gz
*.tar.xz
*.tgz

# ---------------------------------------------------------------------------
# Python environment / caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# ---------------------------------------------------------------------------
# Credentials / secrets / environment files
# ---------------------------------------------------------------------------
.env
.env.*
*.env
credentials*
secrets*
*.key
*.pem
*.pfx
*.p12

# ---------------------------------------------------------------------------
# IDE / editor local state
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# ZCode / agent local state (keep config templates and skills)
# ---------------------------------------------------------------------------
.zcode/plans/
.zcode/**/*.log
.agents/**/*.log
.agents/**/*.pdf

# ---------------------------------------------------------------------------
# Runtime logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Generated outputs / caches / benchmark artifacts
# ---------------------------------------------------------------------------
outputs/
benchmark/

# Per-score working directories containing copyrighted source material,
# Audiveris OMR output, MuseScore files, rendered images, and QA artifacts.
colores_test/
colores_v2/
final_production/
full_score_original_rebuilt/
LOGIC_PRO_DELIVERY/
prototype_pages_1_2/

# Common generated sub-directories across output trees
*/previews/
*/source_pages/
*/qa_crops/
*/rendered/
*/omr/

# ---------------------------------------------------------------------------
# Score file formats (source scans and generated exports)
# ---------------------------------------------------------------------------
*.pdf
*.mscz
*.mscx
*.omr
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.wav
*.mp3
*.mp4
*.mov

# Root-level named score exports
天使的脸*.musicxml
天使的脸*.pdf
天使的脸*.mscz
天使的脸*.mscx
天使的脸*.png
Colores*.pdf
Colores*.musicxml
Colores*.mscz
Colores*.mscx

# ---------------------------------------------------------------------------
# Keep project source / safe config templates (explicit allow-list)
# ---------------------------------------------------------------------------
!src/
!src/omr/
!src/omr/**
# The source allow-list above must not re-include generated Python caches.
src/omr/**/__pycache__/
src/omr/**/*.py[cod]
!tests/
!docs/
!rules/
!frontend/
!web_api/
!licensing/
!reports/
!AGENTS.md
!requirements.txt
!.zcode/config.json
!.zcode/skills/
!.zcode-plugin/
!.agents/skills/orchestral-score-rebuild/

# ---------------------------------------------------------------------------
# Phase 0.5 reproducibility boundary
# ---------------------------------------------------------------------------
# Local OMR/model virtual environments
.venv_homr/
.venv_oemer/

# Per-run workspaces, synthetic smoke artifacts, and temporary audit clones
workdir/
.tmp/
tmp_rest_test*.musicxml
orchestral_rebuild_*/

# Benchmark outputs are generated; benchmark source/config belongs elsewhere.
benchmarks/

# MusicXML schema is acquired from the pinned official revision and verified
# locally. Provenance/setup are tracked in docs/MUSICXML_SCHEMA_SETUP.md.
third_party/musicxml_4_0/schema/

# Generated Phase 2+/benchmark reports that are not V0.1 runtime inputs.
reports/CHOPIN_*
reports/fidelity_recovery_*
reports/multi_omr_benchmark_*
reports/musicxml_normalization_*
reports/normalization_v1_summary.json
reports/phase4b_*
reports/reconstruction_pipeline_v1.md
reports/recovery_router_v1.md
reports/reference_fidelity_audit.md
