{
  "schema_version": 1,
  "project": {
    "name": "ScoreRebuild",
    "version": "0.1.0-candidate",
    "license": "AGPL-3.0-only",
    "freeze_status": "not_frozen",
    "platforms": ["Windows 10", "Windows 11"],
    "python": ">=3.12,<3.13"
  },
  "required_binaries": [
    {
      "id": "pdftoppm",
      "display_name": "Poppler pdftoppm",
      "override_env": "PDFTOPPM_EXE",
      "command_names": ["pdftoppm.exe", "pdftoppm"],
      "version_args": ["-v"],
      "tested_version": "26.05.0",
      "repair": "Install Poppler for Windows, then add its bin directory to PATH or set PDFTOPPM_EXE."
    },
    {
      "id": "audiveris",
      "display_name": "Audiveris",
      "override_env": "AUDIVERIS_EXE",
      "command_names": ["Audiveris.exe", "audiveris"],
      "common_windows": ["{PROGRAMFILES}/Audiveris/Audiveris.exe"],
      "version_args": ["-version"],
      "tested_version": "5.11.0",
      "repair": "Install Audiveris 5.11.0 or a tested compatible release, then set AUDIVERIS_EXE if doctor cannot find it."
    },
    {
      "id": "musescore",
      "display_name": "MuseScore Studio 4",
      "override_env": "MUSESCORE_EXE",
      "command_names": ["MuseScore4.exe", "MuseScore4", "mscore"],
      "common_windows": [
        "{PROGRAMFILES}/MuseScore 4/bin/MuseScore4.exe",
        "{PROGRAMFILES}/MuseScore Studio 4/bin/MuseScore4.exe"
      ],
      "version_args": ["--version"],
      "tested_version": "4.7.4",
      "repair": "Install MuseScore Studio 4, then set MUSESCORE_EXE if doctor cannot find MuseScore4.exe."
    }
  ],
  "required_python_packages": [
    {"distribution": "lxml", "import_name": "lxml", "specifier": ">=6.1.1,<7"},
    {"distribution": "numpy", "import_name": "numpy", "specifier": ">=2.5.2,<3"},
    {"distribution": "Pillow", "import_name": "PIL", "specifier": ">=12.3.0,<13"},
    {"distribution": "pypdf", "import_name": "pypdf", "specifier": ">=6.16.0,<7"},
    {"distribution": "music21", "import_name": "music21", "specifier": ">=10.5.0,<11"},
    {"distribution": "partitura", "import_name": "partitura", "specifier": ">=1.9.0,<2"},
    {"distribution": "musicdiff", "import_name": "musicdiff", "specifier": ">=5.2,<6"},
    {"distribution": "pypdfium2", "import_name": "pypdfium2", "specifier": ">=5.13.0,<6"},
    {"distribution": "PyMuPDF", "import_name": "pymupdf", "fallback_import_name": "fitz", "specifier": ">=1.24,<2"}
  ],
  "optional_python_packages": [
    {
      "distribution": "pdfplumber",
      "import_name": "pdfplumber",
      "specifier": ">=0.11.9,<1",
      "purpose": "Optional legacy/advanced PDF text extraction. The core ScoreRebuild workflow does not require the private fixture-specific scripts that imported it."
    }
  ],
  "required_internal_skills": [
    {
      "name": "focused-score-rebuild",
      "path": ".agents/skills/focused-score-rebuild/SKILL.md",
      "resources": [
        ".agents/skills/focused-score-rebuild/agents/openai.yaml",
        ".agents/skills/focused-score-rebuild/references/intake-and-library-classification.md",
        ".agents/skills/focused-score-rebuild/references/multilingual-metadata.md",
        ".agents/skills/focused-score-rebuild/references/human-review-dialogue.md",
        ".agents/skills/focused-score-rebuild/references/review-issue-schema.md",
        ".agents/skills/focused-score-rebuild/references/qa-protocol.md",
        ".agents/skills/focused-score-rebuild/references/successful-run-procedure.md",
        ".agents/skills/focused-score-rebuild/references/windows-toolchain-bootstrap.md",
        ".agents/skills/focused-score-rebuild/assets/QA_REPORT_TEMPLATE.md",
        ".agents/skills/focused-score-rebuild/assets/PRODUCTION_STAGE_GATES_QA.md",
        ".agents/skills/focused-score-rebuild/assets/windows-toolchain-manifest.json",
        ".agents/skills/focused-score-rebuild/scripts/bootstrap_tools.ps1",
        ".agents/skills/focused-score-rebuild/scripts/library_catalog.py",
        ".agents/skills/focused-score-rebuild/scripts/make_audiveris_playlist.py",
        ".agents/skills/focused-score-rebuild/scripts/metadata_record.py",
        ".agents/skills/focused-score-rebuild/scripts/review_queue.py",
        ".agents/skills/focused-score-rebuild/scripts/musicxml_invariants.py"
      ]
    }
  ],
  "musicxml_schema": {
    "version": "4.0",
    "bundled": false,
    "override_env": "MUSICXML_SCHEMA_DIR",
    "default_path": "third_party/musicxml_4_0/schema",
    "source_repository": "https://github.com/w3c-cg/musicxml.git",
    "source_tag": "v4.0",
    "source_commit": "799e2defb2ece0ae7bafe08dcbcac25b2c631d53",
    "raw_base_url": "https://raw.githubusercontent.com/w3c-cg/musicxml/799e2defb2ece0ae7bafe08dcbcac25b2c631d53/schema",
    "files": {
      "musicxml.xsd": "bfe37ed25a9ec00e6f2591d53df260b84efe12aed209ba3ac0a76f9287665a99",
      "xlink.xsd": "6e601f8eeb41618b50e4c7f944dff754e57ea43b602755470dda24c9c2f6df92",
      "xml.xsd": "616a3077df5cfc954ac74a75abe9697b95eef7a85dbe09367d995a483e840eb5",
      "container.xsd": "deddcc2f51e856de21397bbe25e2cf304ca9e3253b0d25dcc6349c390bc22fa6",
      "catalog.xml": "c65df54cbf1c6bd73a335d47c0ec292c4c1d7ecca20dbb6e36388bb169c71245"
    },
    "setup_command": "python -m score_rebuild schema-install"
  },
  "capability_requirements": {
    "code_reasoning_provider": "required_and_explicitly_verified",
    "visual_review_provider": "required_or_manual_visual_review",
    "human_review_fallback": "required"
  },
  "optional_integrations": [
    "ZCode profiles",
    "Codex project discovery",
    "GitHub connector",
    "MuseScore MCP",
    "web search",
    "Logic Pro downstream import"
  ],
  "supported_environment_variables": [
    "PYTHON_EXE",
    "PDFTOPPM_EXE",
    "AUDIVERIS_EXE",
    "AUDIVERIS_JAVA_EXE",
    "MUSESCORE_EXE",
    "MUSICXML_SCHEMA_DIR",
    "SCORE_REBUILD_CODE_REASONING_PROVIDER",
    "SCORE_REBUILD_CODE_REASONING_VERIFIED",
    "SCORE_REBUILD_VISUAL_REVIEW_PROVIDER",
    "SCORE_REBUILD_VISUAL_REVIEW_VERIFIED",
    "SCORE_REBUILD_HUMAN_REVIEWER",
    "SCORE_REBUILD_PRIVATE_FIXTURE_MUSICXML",
    "SCORE_REBUILD_PRIVATE_FIXTURE_OUTPUT_DIR",
    "LLM_BASE_URL",
    "LLM_API_KEY",
    "LLM_MODEL",
    "LLM_SUPPORTS_TEMPERATURE"
  ]
}
